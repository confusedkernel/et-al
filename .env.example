# --- Required ---
OPENROUTER_API_KEY=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# --- Instance ---
# password: local accounts (first user becomes admin) | none: single-user, no login
AUTH_MODE=password
ALLOW_SIGNUP=true
DEFAULT_USER_BUDGET_USD=10
POSTGRES_PASSWORD=etal
HTTP_PORT=8080
# Set a public domain to get automatic HTTPS from Caddy (then also set COOKIE_SECURE=true)
DOMAIN=
COOKIE_SECURE=false

# --- Agents ---
# searxng | exa | tavily
SEARCH_BACKEND=searxng
# docker | e2b
SANDBOX_BACKEND=docker
EXA_API_KEY=
TAVILY_API_KEY=
E2B_API_KEY=
